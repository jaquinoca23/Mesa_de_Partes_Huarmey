# Plantilla de variables de entorno. Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" NUNCA se sube a GitHub (ya está en .gitignore).

# Clave secreta de Django. Este valor es SOLO para desarrollo local; cámbialo.
DJANGO_SECRET_KEY=dev-only-cambia-esta-clave-en-tu-archivo-env

# True solo en tu computadora. En un servidor real debe ser False.
DJANGO_DEBUG=True

# Direcciones desde las que Django acepta peticiones (separadas por comas).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Direcciones del frontend autorizadas a llamar a la API (separadas por comas).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de datos PostgreSQL (se crea siguiendo database/README.md).
DB_ENGINE=postgresql
DB_NAME=mesa_partes_huarmey
DB_USER=mesa_partes_user
# Usa la MISMA contraseña que pusiste en database/crear_base_datos.sql (solo en tu .env).
DB_PASSWORD=73538479
DB_HOST=localhost
DB_PORT=5432

# Archivos adjuntos del formulario (OPCIONALES: si no los escribes se usan estos valores).
# Son provisionales hasta que la municipalidad apruebe los tipos y tamaños permitidos.
# Tipos que el sistema sabe verificar: pdf, jpg, jpeg, png, docx, xlsx
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,docx

# Carpeta PRIVADA de adjuntos (OPCIONAL; por defecto backend/storage_privado). Nunca subir a GitHub.
# PRIVATE_MEDIA_ROOT=

# Correo (OPCIONAL). Por defecto el correo se imprime en la terminal de Django (no sale a internet).
# Para enviar correos reales: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend y los datos del servidor.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=

# Sesión del personal (OPCIONAL): horas de duración (por defecto 8).
# SESSION_HORAS=8
# Pon True SOLO cuando el sitio se publique con HTTPS.
# DJANGO_HTTPS=False

# Verificación de DNI (OPCIONAL). Sin IDENTIDAD_API_TOKEN el botón "Verificar DNI" no aparece.
# Servicio de terceros (APIsPERU): sirve para la demostración; para producción corresponde convenio con RENIEC/PIDE.
# El token es SECRETO: solo va aquí, nunca en React ni en GitHub.
IDENTIDAD_API_URL=https://dniruc.apisperu.com/api/v1/dni
IDENTIDAD_API_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6Impob24xY291cnRvaXMxMjNAZ21haWwuY29tIiwianRpIjoiNjE4MDIzZTgzY2JlOGI2MCJ9.Q7Q-oFDmj-QWtbZRLW3b3VEHldUq5iGp5ELVAPLEXtA
# IDENTIDAD_TIMEOUT=8
